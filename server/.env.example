PORT=3002
NODE_ENV=development

# 기본 사업장(default) 초기 관리자 PIN (최초 마이그레이션 시에만 사용)
MANAGER_PIN=1234

# SQLite DB 파일 경로 (기본: ../data/alba.db)
# DB_PATH=/absolute/path/to/alba.db

# 프로덕션 환경에서 허용할 프론트엔드 Origin
# ALLOWED_ORIGIN=https://yourdomain.com

# 구글 OAuth 2.0 (사장님 구글 로그인용. 미설정 시 PIN 전용으로 동작)
# Google Cloud Console에서 OAuth 2.0 Client ID 생성 후 채우기
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# OAuth redirect base. dev: http://localhost:5174  /  prod: https://your-domain
# PUBLIC_ORIGIN=http://localhost:5174

# 운영자 콘솔(/admin) 접근 가능한 이메일 목록. 콤마로 구분. 비우면 어드민 기능 비활성
# ADMIN_EMAILS=운영자@gmail.com,파트너@gmail.com
